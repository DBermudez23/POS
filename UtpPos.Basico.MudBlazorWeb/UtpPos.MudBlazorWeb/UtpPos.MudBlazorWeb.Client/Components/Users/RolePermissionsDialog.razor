@inject IRbacManagementService RbacManagementService
@inject IAuthService AuthService
@inject PermissionStateService PermissionState
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                @_errorMessage
            </MudAlert>
        }

        <div class="vp-rbac-dialog-head">
            <div>
                <MudText Typo="Typo.subtitle2">@Role.Name</MudText>
                <MudText Typo="Typo.body2" Class="vp-muted">@(Role.BusinessName ?? "Global")</MudText>
            </div>
        </div>

        <div class="vp-rbac-inline-form">
            <MudSelect T="int?"
                       Label="Asignar permiso"
                       @bind-Value="_selectedPermissionId"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@(_loading || !PermissionState.HasPermission("roles.actualizar"))">
                @foreach (var permission in _permissions)
                {
                    <MudSelectItem T="int?" Value="@permission.Id">
                        @permission.PermissionName
                    </MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(_loading || !_selectedPermissionId.HasValue || !PermissionState.HasPermission("roles.actualizar"))"
                       OnClick="AssignPermissionAsync">
                Asignar
            </MudButton>
        </div>

        @if (_loading)
        {
            <div class="vp-rbac-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="vp-muted">Consultando permisos del rol...</MudText>
            </div>
        }
        else if (_assignments.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Key"
                        Title="Sin permisos asignados"
                        Message="Este rol aun no tiene permisos activos asignados." />
        }
        else
        {
            <section class="vp-card vp-rbac-table-card vp-rbac-table-card--compact">
                <MudTable T="RbacRolePermissionDto" Items="@_assignments" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Permiso</MudTh>
                        <MudTh>Modulo</MudTh>
                        <MudTh>Accion</MudTh>
                        <MudTh Class="vp-rbac-actions-heading">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Permiso">
                            <div class="vp-rbac-user-cell">
                                <strong>@context.PermissionName</strong>
                                <span>@(string.IsNullOrWhiteSpace(context.PermissionDescription) ? "Sin descripcion" : context.PermissionDescription)</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Modulo">@context.ModuleName</MudTd>
                        <MudTd DataLabel="Accion">@context.ActionName</MudTd>
                        <MudTd DataLabel="Acciones">
                            @if (PermissionState.HasPermission("roles.actualizar"))
                            {
                                <MudTooltip Text="Revocar permiso">
                                    <MudIconButton Icon="@Icons.Material.Outlined.LinkOff"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RevokePermissionAsync(context))" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </section>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public RbacRoleDto Role { get; set; } = new();

    private IReadOnlyList<RbacPermissionDto> _permissions = Array.Empty<RbacPermissionDto>();
    private IReadOnlyList<RbacRolePermissionDto> _assignments = Array.Empty<RbacRolePermissionDto>();
    private int? _selectedPermissionId;
    private bool _loading;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = string.Empty;

        try
        {
            var permissionsTask = RbacManagementService.ListPermissionsAsync(new RbacPermissionFilterDto { Status = "A" });
            var assignmentsTask = RbacManagementService.ListRolePermissionsAsync(Role.Id);

            await Task.WhenAll(permissionsTask, assignmentsTask);

            var permissionsResponse = await permissionsTask;
            var assignmentsResponse = await assignmentsTask;

            if (!permissionsResponse.IsSuccess)
            {
                await HandleFailureAsync(permissionsResponse.Message);
                return;
            }

            if (!assignmentsResponse.IsSuccess)
            {
                await HandleFailureAsync(assignmentsResponse.Message);
                return;
            }

            _permissions = permissionsResponse.Data ?? Array.Empty<RbacPermissionDto>();
            _assignments = assignmentsResponse.Data ?? Array.Empty<RbacRolePermissionDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AssignPermissionAsync()
    {
        if (!_selectedPermissionId.HasValue)
        {
            return;
        }

        var response = await RbacManagementService.AssignPermissionToRoleAsync(Role.Id, _selectedPermissionId.Value);
        if (!response.IsSuccess)
        {
            await HandleFailureAsync(response.Message);
            return;
        }

        Snackbar.Add(response.Message, Severity.Success);
        _selectedPermissionId = null;
        await LoadAsync();
    }

    private async Task RevokePermissionAsync(RbacRolePermissionDto assignment)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Revocar permiso",
            $"Deseas revocar {assignment.PermissionName}?",
            yesText: "Revocar",
            noText: null,
            cancelText: "Cancelar");

        if (confirmed != true)
        {
            return;
        }

        var response = await RbacManagementService.RevokePermissionFromRoleAsync(Role.Id, assignment.PermissionId);
        if (!response.IsSuccess)
        {
            await HandleFailureAsync(response.Message);
            return;
        }

        Snackbar.Add(response.Message, Severity.Success);
        await LoadAsync();
    }

    private void Close() => Dialog.Close();

    private async Task HandleFailureAsync(string? message)
    {
        var resolvedMessage = string.IsNullOrWhiteSpace(message)
            ? "No fue posible completar la operacion."
            : message;

        if (resolvedMessage.StartsWith("Sesion expirada", StringComparison.OrdinalIgnoreCase)
            || resolvedMessage.StartsWith("No hay una sesion activa", StringComparison.OrdinalIgnoreCase)
            || resolvedMessage.StartsWith("Sesi", StringComparison.OrdinalIgnoreCase))
        {
            await AuthService.LogoutAsync();
            Dialog.Cancel();
            Snackbar.Add("Tu sesion termino. Inicia sesion nuevamente.", Severity.Warning);
            NavigationManager.NavigateTo("/login", replace: true);
            return;
        }

        _errorMessage = resolvedMessage;
        Snackbar.Add(resolvedMessage, Severity.Error);
    }
}
