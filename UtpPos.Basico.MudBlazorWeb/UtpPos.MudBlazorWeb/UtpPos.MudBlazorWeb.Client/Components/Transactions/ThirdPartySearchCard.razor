<section class="vp-card vp-customer-search-card" aria-label="@AriaLabel">
    <div class="vp-customer-search-header">
        <div class="vp-customer-search-header-elements">
            <div>
                <span>@Kicker</span>
                <h2>@Title</h2>
                <p>@Subtitle</p>
            </div>
            @if (ShowCreateButton)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@CreateButtonIcon"
                           Class="vp-new-customer-button"
                           Disabled="@CreateButtonDisabled"
                           OnClick="OnCreateClick">
                    @CreateButtonText
                </MudButton>
            }
        </div>
        @if (SelectedThirdParty is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                @SelectedChipText
            </MudChip>
        }
    </div>

    @if (SelectedThirdParty is not null)
    {
        <div class="vp-selected-customer">
            <div class="vp-selected-customer-avatar" aria-hidden="true">@GetInitials(SelectedThirdParty.Name, InitialsFallback)</div>
            <div class="vp-selected-customer-copy">
                <strong>@SelectedThirdParty.Name</strong>
                <span>@ResolveText(SelectedThirdParty.DocumentTypeName, $"Tipo #{SelectedThirdParty.DocumentTypeId}") @SelectedThirdParty.DocumentNumber</span>
                <small>@BuildMeta(SelectedThirdParty)</small>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Outlined.ChangeCircle" Disabled="@Disabled" OnClick="OnClearSelected">
                @ChangeButtonText
            </MudButton>
        </div>
    }
    else
    {
        <div class="vp-customer-search-grid">
            <div class="vp-customer-search-panel">
                <div class="vp-customer-search-panel-title">
                    <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" />
                    <span>Busqueda por documento</span>
                </div>
                <div class="vp-customer-document-grid">
                    <MudSelect T="int?" Label="Tipo de documento" Value="@DocumentTypeId" ValueChanged="DocumentTypeIdChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Disabled="@Disabled">
                        @foreach (var documentType in DocumentTypes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)documentType.Id)">@GetParameterLabel(documentType)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Numero de documento" Value="@DocumentNumber" ValueChanged="DocumentNumberChanged" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" Disabled="@Disabled" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" Disabled="@Disabled" OnClick="OnSearchByDocument">
                        Buscar por documento
                    </MudButton>
                </div>
            </div>

            <div class="vp-customer-search-panel">
                <div class="vp-customer-search-panel-title">
                    <MudIcon Icon="@Icons.Material.Outlined.PersonSearch" Size="Size.Small" />
                    <span>Busqueda por nombre</span>
                </div>
                <div class="vp-customer-name-grid">
                    <MudTextField T="string" Label="Buscar por nombre" Value="@NameSearch" ValueChanged="NameSearchChanged" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="60" Disabled="@Disabled" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" Disabled="@Disabled" OnClick="OnSearchByName">
                        Buscar
                    </MudButton>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(SearchMessage))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                @SearchMessage
            </MudAlert>
        }

        @if (Searching)
        {
            <div class="vp-customer-search-loading">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                <span>@SearchingText</span>
            </div>
        }
        else if (Results.Count > 0)
        {
            <div class="vp-customer-results" aria-label="@ResultsAriaLabel">
                @foreach (var thirdParty in Results)
                {
                    <button type="button" class="vp-customer-result" disabled="@Disabled" @onclick="() => OnSelectResult.InvokeAsync(thirdParty)">
                        <span class="vp-customer-result-avatar">@GetInitials(thirdParty.Name, InitialsFallback)</span>
                        <span class="vp-customer-result-copy">
                            <strong>@thirdParty.Name</strong>
                            <small>@ResolveText(thirdParty.DocumentTypeName, $"Tipo #{thirdParty.DocumentTypeId}") @thirdParty.DocumentNumber</small>
                            <em>@BuildMeta(thirdParty)</em>
                        </span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </button>
                }
            </div>
        }

        @ChildContent
    }
</section>

@code {
    [Parameter]
    public string AriaLabel { get; set; } = "Seleccion de tercero";

    [Parameter]
    public string Kicker { get; set; } = "Tercero";

    [Parameter]
    public string Title { get; set; } = "Selecciona un tercero registrado";

    [Parameter]
    public string Subtitle { get; set; } = "Busca por documento o por nombre dentro del negocio seleccionado.";

    [Parameter]
    public string SelectedChipText { get; set; } = "Tercero seleccionado";

    [Parameter]
    public string ChangeButtonText { get; set; } = "Cambiar tercero";

    [Parameter]
    public string SearchingText { get; set; } = "Buscando terceros...";

    [Parameter]
    public string ResultsAriaLabel { get; set; } = "Resultados de terceros";

    [Parameter]
    public string InitialsFallback { get; set; } = "TE";

    [Parameter]
    public bool ShowThirdPartyType { get; set; }

    [Parameter]
    public bool ShowCreateButton { get; set; }

    [Parameter]
    public string CreateButtonText { get; set; } = "Nuevo tercero";

    [Parameter]
    public string CreateButtonIcon { get; set; } = Icons.Material.Outlined.PersonAdd;

    [Parameter]
    public bool CreateButtonDisabled { get; set; }

    [Parameter]
    public EventCallback OnCreateClick { get; set; }

    [Parameter]
    public IReadOnlyList<ParameterOptionDto> DocumentTypes { get; set; } = Array.Empty<ParameterOptionDto>();

    [Parameter]
    public IReadOnlyList<ThirdPartyDto> Results { get; set; } = Array.Empty<ThirdPartyDto>();

    [Parameter]
    public ThirdPartyDto? SelectedThirdParty { get; set; }

    [Parameter]
    public int? DocumentTypeId { get; set; }

    [Parameter]
    public EventCallback<int?> DocumentTypeIdChanged { get; set; }

    [Parameter]
    public string DocumentNumber { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> DocumentNumberChanged { get; set; }

    [Parameter]
    public string NameSearch { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> NameSearchChanged { get; set; }

    [Parameter]
    public string SearchMessage { get; set; } = string.Empty;

    [Parameter]
    public bool Searching { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnSearchByDocument { get; set; }

    [Parameter]
    public EventCallback OnSearchByName { get; set; }

    [Parameter]
    public EventCallback OnClearSelected { get; set; }

    [Parameter]
    public EventCallback<ThirdPartyDto> OnSelectResult { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static string GetParameterLabel(ParameterOptionDto option) =>
        string.IsNullOrWhiteSpace(option.Code) ? option.Description : option.Description;

    private string BuildMeta(ThirdPartyDto thirdParty)
    {
        var meta = ResolveText(thirdParty.Phone, "Sin telefono");
        return ShowThirdPartyType
            ? $"{meta} · {ResolveText(thirdParty.ThirdPartyTypeName, $"Tipo tercero #{thirdParty.ThirdPartyTypeId}")}"
            : meta;
    }

    private static string ResolveText(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string GetInitials(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 0
            ? fallback
            : string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
